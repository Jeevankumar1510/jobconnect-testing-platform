{
  "info": {
    "_postman_id": "b41da395-eab1-4d5d-8e69-31cd516ce527",
    "name": "JobConnect API",
    "description": "Manual smoke and workflow checks for the JobConnect FastAPI service. Import the JobConnect Local environment and set testPassword before running. The workflow creates a candidate, recruiter, job, and application; follow the post-run cleanup instructions so test data and uploaded files do not accumulate.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health returns 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Health status is ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Register candidate",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('candidateEmail', 'candidate-' + pm.variables.replaceIn('{{$guid}}') + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Candidate registration returns 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Candidate role is returned without password hash', function () { var body = pm.response.json(); pm.expect(body.role).to.eql('candidate'); pm.expect(body).not.to.have.property('hashed_password'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"candidate\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "Login candidate",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Candidate login returns 200', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "pm.environment.set('candidateToken', body.access_token);",
              "pm.test('Login returns a bearer token', function () { pm.expect(body.token_type).to.eql('bearer'); pm.expect(body.access_token).to.be.a('string').and.not.empty; });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "Register recruiter",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('recruiterEmail', 'recruiter-' + pm.variables.replaceIn('{{$guid}}') + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Recruiter registration returns 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Recruiter role is returned', function () { pm.expect(pm.response.json().role).to.eql('recruiter'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{recruiterEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"recruiter\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "Login recruiter",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Recruiter login returns 200', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "pm.environment.set('recruiterToken', body.access_token);",
              "pm.test('Recruiter login returns a bearer token', function () { pm.expect(body.token_type).to.eql('bearer'); pm.expect(body.access_token).to.be.a('string').and.not.empty; });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{recruiterEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "Candidate cannot create a job",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{candidateToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Unauthorized test job\",\n  \"company\": \"JobConnect QA\",\n  \"location\": \"Remote\",\n  \"description\": \"This request should be rejected for a candidate.\",\n  \"employment_type\": \"full_time\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/jobs"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Candidate is forbidden from creating jobs', function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Recruiter creates a job",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{recruiterToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Python Test Automation Engineer\",\n  \"company\": \"JobConnect QA Demo\",\n  \"location\": \"Remote\",\n  \"description\": \"Create and maintain Python API tests.\",\n  \"employment_type\": \"full_time\",\n  \"salary_min\": 85000,\n  \"salary_max\": 110000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/jobs"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Recruiter job creation returns 201', function () { pm.response.to.have.status(201); });",
              "var body = pm.response.json();",
              "pm.environment.set('jobId', body.id);",
              "pm.test('Created job belongs to the recruiter', function () { pm.expect(body.recruiter_id).to.be.a('number'); pm.expect(body.status).to.eql('open'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Search jobs with filters and pagination",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/jobs?q=Python&location=Remote&employment_type=full_time&salary_min=90000&salary_max=120000&page=1&page_size=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Filtered job search returns 200', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "pm.test('Search pagination metadata is present', function () { pm.expect(body.page).to.eql(1); pm.expect(body.page_size).to.eql(10); pm.expect(body.total).to.be.at.least(1); });",
              "pm.test('Created job matches the filters', function () { pm.expect(body.items.some(function (job) { return String(job.id) === String(pm.environment.get('jobId')); })).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Candidate applies with a resume",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{candidateToken}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "job_id",
              "value": "{{jobId}}",
              "type": "text"
            },
            {
              "key": "cover_letter",
              "value": "I am interested in this role.",
              "type": "text"
            },
            {
              "key": "resume",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/applications"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Application with resume returns 201', function () { pm.response.to.have.status(201); });",
              "var body = pm.response.json();",
              "pm.environment.set('applicationId', body.id);",
              "pm.test('Application starts in submitted status', function () { pm.expect(body.status).to.eql('submitted'); pm.expect(body.resume_filename).to.be.a('string').and.not.empty; });"
            ]
          }
        }
      ]
    },
    {
      "name": "Duplicate application is rejected",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{candidateToken}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "job_id",
              "value": "{{jobId}}",
              "type": "text"
            },
            {
              "key": "resume",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": "{{baseUrl}}/api/v1/applications"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Duplicate application returns 409', function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Candidate views own applications",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{candidateToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/applications/mine?page=1&page_size=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Candidate application list returns 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Created application is in the candidate list', function () { var body = pm.response.json(); pm.expect(body.items.some(function (item) { return String(item.id) === String(pm.environment.get('applicationId')); })).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Recruiter views applicants for own job",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{recruiterToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/applications/jobs/{{jobId}}?page=1&page_size=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Recruiter application list returns 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Created application is in the recruiter list', function () { var body = pm.response.json(); pm.expect(body.items.some(function (item) { return String(item.id) === String(pm.environment.get('applicationId')); })).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Recruiter moves application to reviewing",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{recruiterToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"reviewing\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/applications/{{applicationId}}/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Recruiter status update returns 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Application status is reviewing', function () { pm.expect(pm.response.json().status).to.eql('reviewing'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Candidate cannot update application status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{candidateToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"interview\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/applications/{{applicationId}}/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Candidate status update is forbidden', function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid application transition is rejected",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{recruiterToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"submitted\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/applications/{{applicationId}}/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Invalid status transition returns 409', function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Candidate downloads own resume",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{candidateToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/applications/{{applicationId}}/resume"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Resume download returns 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Downloaded resume is a PDF', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/pdf'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Recruiter closes own job",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{recruiterToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"closed\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Recruiter closes job successfully', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('closed'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Closed job is not public",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/jobs/{{jobId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Closed job returns 404 to public users', function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Recruiter can track applications after closing job",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{recruiterToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/applications/jobs/{{jobId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Recruiter still sees closed-job applications', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().items[0].status).to.eql('reviewing'); });"
            ]
          }
        }
      ]
    }
  ]
}
